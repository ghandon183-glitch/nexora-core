{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexora-core",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Route `/downloads/*` requests through the Worker first so direct
    // public access to paid ZIP assets can be denied in `middleware.ts`.
    // Other static assets continue to bypass the Worker for performance.
    // See https://developers.cloudflare.com/workers/static-assets/binding/#run_worker_first
    "run_worker_first": ["/downloads/*"]
  },
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "nexora-orders",
      "database_id": "86c93b1f-9eab-4b0f-acc4-4d3e53f9b395"
    }
  ]
}
