# ─── Admin panel authentication ───────────────────────────────────────
# Password used to sign in at /admin. Store this as a Cloudflare Secret
# (Workers → nexora-core → Settings → Variables), never as plaintext.
ADMIN_PASSWORD=

# ─── Payment verification (cron) ──────────────────────────────────────
# Shared secret that authorizes the scheduled payment-check job to call
# /api/cron/check-payments (sent via the x-cron-secret header).
CRON_SECRET=

# Optional: TronGrid API key for higher USDT (TRC20) verification rate limits.
TRONGRID_API_KEY=

# ─── Email notifications and customer-facing email ────────────────────
# Email delivery uses Resend's HTTPS API, which is compatible with
# Cloudflare Workers. Create an API key at https://resend.com/api-keys
# and store it as a Cloudflare Worker secret.
RESEND_API_KEY=

# Required sender address, using a domain verified in Resend.
# Example: Nexora Core <no-reply@your-verified-domain.example>
# Replace the example with your actual verified domain/address.
RESEND_FROM_EMAIL=

# Inbox for owner notifications and admin email tests.
NOTIFY_EMAIL=

# ─── Production site URL ──────────────────────────────────────────────
SITE_URL=

# Optional SEO / analytics integrations
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
