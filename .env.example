# ─── Admin panel authentication ───────────────────────────────────────
# Store secrets in Cloudflare Workers → nexora-core → Settings → Variables.
ADMIN_PASSWORD=

# ─── Payment verification (cron) ──────────────────────────────────────
CRON_SECRET=
TRONGRID_API_KEY=

# ─── Customer-facing email via Gmail API HTTPS (no SMTP, no custom domain)
# GMAIL_USER is the Gmail mailbox Nexora will send from.
GMAIL_USER=
# Create an OAuth 2.0 Web application client in Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# OAuth refresh token authorized for the Gmail API gmail.send scope.
# Store all OAuth credentials as Worker secrets; never commit real values.
GMAIL_REFRESH_TOKEN=

# Owner notifications can use Resend's free testing sender only when the
# recipient is the Resend account owner's own email. Arbitrary customers
# require a verified sender domain; do not configure that until affordable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_EMAIL=

# ─── Production site URL ──────────────────────────────────────────────
SITE_URL=

# Optional SEO / analytics integrations
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
