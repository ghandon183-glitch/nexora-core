{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexora-payment-cron",
  "main": "workers/payment-cron.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
